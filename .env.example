DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend from https://resend.com
RESEND_API_KEY="re_..."
EMAIL_FROM="MY BOOK STORE <onboarding@resend.dev>"

# Gmail for OTP codes and receipts (recommended). Use a Google App Password:
# https://myaccount.google.com/apppasswords  (needs 2-Step Verification on)
SMTP_USER="you@gmail.com"
SMTP_PASS=""
# Optional: SMTP_HOST="smtp.gmail.com"  SMTP_PORT="465"  SMTP_FROM="MY BOOK STORE <you@gmail.com>"
