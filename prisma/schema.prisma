generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum ShippingStatus {
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
  ratings      Rating[]
  books        Book[]   @relation("SellerBooks")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  priceCents  Int
  pages       Int
  condition   String
  description String
  category    String
  stock       Int      @default(5)
  /// Null = a store book added by the admin. Otherwise the seller who listed it.
  sellerId    String?
  seller      User?    @relation("SellerBooks", fields: [sellerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  ratings     Rating[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          OrderStatus @default(PENDING)
  stripeSessionId String?     @unique
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  emailStatus     String?
  paidAt          DateTime?
  shippingStatus    ShippingStatus @default(PROCESSING)
  shippingUpdatedAt DateTime?
  /// Set when the customer or admin cancels before shipping.
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledBy     String?
  refundId        String?
  refundStatus    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  bookId         String
  title          String
  unitPriceCents Int
  qty            Int
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book           Book   @relation(fields: [bookId], references: [id])
}

model Category {
  id        String   @id
  name      String
  blurb     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Rating {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([bookId, userId])
}

/// One-time 6-digit codes emailed for sign-in and order confirmation.
model OtpCode {
  id         String    @id @default(cuid())
  email      String
  purpose    String
  context    String?
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}
